# Streamlit secrets template.
# LOCAL:  copy to .streamlit/secrets.toml (gitignored) and fill in.
# CLOUD:  paste these keys into the Streamlit Community Cloud "Secrets" UI
#         (App -> Settings -> Secrets). Do NOT commit the real values.

# Access gate for this internal tool. If unset, the app is UNGUARDED —
# always set this when deploying.
FREQREG_PASSCODE = "change-me"

# PJM DataMiner2 API key (same account as PJM-5CP), used for the live ACE tab.
PJM_API_KEY = "your-pjm-api-key"
